# Auth Service — environment template.
#
#   cp .env.example .env
#   Fill in AUTH_JWT_SECRET (required) and AUTH_MONGO_URI (recommended) below.
#
# Two settings objects read this file:
#   features/config.py  (AuthSettings)    — what the service authenticates against
#   app/config.py       (ServiceSettings) — how the service is exposed (AUTHSVC_ prefix)
# This mirrors the split already used by the sibling llm-gateway (LLM_ vs
# GATEWAY_) and knowledge-service (RAG_ vs KNOWLEDGE_).

# ──────────────────────────────────────────────────────────────────── identity
# HMAC signing key for every issued token. REQUIRED before exposing this
# service anywhere but localhost — with the built-in dev default, anyone who
# has read this source can forge a valid token for any user. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# This service is the trust root for end-user identity (sub/org_id/...) —
# llm-gateway and knowledge-service each validate tokens minted here instead
# of trusting a client-supplied org_id/user_id field. That only works if this
# value is IDENTICAL to LLM_JWT_SECRET (llm-gateway) and RAG_JWT_SECRET
# (knowledge-service) — HS256 is a symmetric signature, so all three services
# must share one secret.
AUTH_JWT_SECRET=

AUTH_JWT_ALGORITHM=HS256

# Stamped onto every issued token as iss/aud. Must equal the downstream
# services' LLM_JWT_ISSUER / RAG_JWT_ISSUER (both default to "auth-service")
# and include their LLM_JWT_AUDIENCE / RAG_JWT_AUDIENCE (both default to
# their own service name) — see this repo's other two services' .env.example.
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=llm-gateway,knowledge-service

# Access-token lifetime in minutes. There is no refresh token — a caller
# re-authenticates once this expires.
#
# This doubles as the revocation window: llm-gateway and knowledge-service
# verify tokens locally and never consult this service's revoked_tokens list,
# so a logged-out or deleted user keeps working against them until their token
# expires. Shorter = tighter revocation, more re-logins.
AUTH_ACCESS_TTL_MINUTES=60

# How long after ISSUE a token may still be exchanged at
# POST /auth/refresh-token. Seven days.
#
# This is what lets the access TTL above stay short. It is an idle timeout, not
# a session length: every refresh mints a token with a fresh `iat`, so an active
# client's window slides forward and only a real absence forces a new sign-in.
#
# It is also the bound on the one thing refresh gives up. That endpoint accepts
# an EXPIRED token by design, so without this window a token recovered from an
# old log would stay exchangeable forever. Each exchange also REVOKES the token
# it consumed, so a token works exactly once — a stolen one buys a single
# refresh, and spending it breaks the real user's next refresh visibly.
#
# 0 disables refresh entirely; clients then re-authenticate when a token expires.
AUTH_REFRESH_TTL_MINUTES=10080

# ──────────────────────────────────────────────────────────────────── storage
# MongoDB connection for the users / app_accounts / revoked_tokens
# collections. This service owns them outright — it is the source of truth
# for identity and never reads an application's own database.
#
# Left empty, the service falls back to process-local in-memory storage —
# fine for a quick local run, but data does not survive a restart and is not
# shared across replicas. The code default for the db name is "app"; use a
# dedicated one, which is what every deployment sets.
AUTH_MONGO_URI=
AUTH_MONGO_DB_NAME=auth_service

# ────────────────────────────────────────────────────────────── password hash
# bcrypt cost for NEW passwords. Verification is multi-scheme: bcrypt
# ($2a/$2b/$2y — including hashes imported from another application) and the
# legacy pbkdf2_sha256 records this service used to write. A stale hash is
# upgraded in place on the user's next successful login, so raising this
# migrates everyone gradually instead of forcing a reset.
AUTH_BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────── administration
# There is NO admin-account setting. Administering this service (the
# app_accounts collection — see features/app_accounts.py) is gated on
# membership of an app account whose app_type is "admin": that is a property
# of the account record, so the service never needs to be told which account
# it is. The account is created once by an operator (README, "Administration")
# and its minted ID is configured into the admin console — VITE_ADMIN_ACCOUNT_ID
# in account-management-ui — which is the only place the value lives.

# ──────────────────────────────────────────────────────────────── service (HTTP)
AUTHSVC_HOST=0.0.0.0
AUTHSVC_PORT=8100
AUTHSVC_ROOT_PATH=
AUTHSVC_LOG_LEVEL=INFO
# "json" (default, log-aggregator friendly) | "text" (human-readable, local dev)
AUTHSVC_LOG_FORMAT=json
# development | staging | production — production upgrades the missing-secret
# warning at startup to an error-level log line.
AUTHSVC_ENVIRONMENT=development

# Set false in production if the API is public.
AUTHSVC_DOCS_ENABLED=true

# Comma-separated browser origins allowed to call this service directly
# (e.g. a web UI's login page), or "*" for any. Service-to-service callers
# are unaffected by CORS.
# The knowledge-ingest-ui dev server runs on :5174 (see its vite.config.ts);
# its deployed Vercel origin is listed alongside it.
# Exact origins. The account-management console runs on :5176 locally.
AUTHSVC_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5176,http://127.0.0.1:5176,https://account-management.vercel.app,https://knowledge-ingest-ui.vercel.app,https://account-management-ui.vercel.app

# Vercel hands every deployment and preview its own hostname, so the exact
# list above goes stale on each deploy. This regex covers the whole family
# for the projects we own — keep it anchored to those project names.
AUTHSVC_CORS_ORIGIN_REGEX=^https://(account-management|knowledge-ingest-ui)[a-z0-9-]*\.vercel\.app$

AUTHSVC_REQUEST_ID_HEADER=X-Request-ID
AUTHSVC_EXPOSE_CONFIG_ENDPOINT=true

# ────────────────────────────────────────────────────────────────────────────
# Password reset  (POST /auth/forgot-password, POST /auth/reset-password)
# ────────────────────────────────────────────────────────────────────────────
#
# READ THIS BEFORE DEPLOYING. /auth/forgot-password always answers 200 with the
# same generic message, so an unauthenticated caller cannot use it to discover
# which addresses are registered. The cost of that property is that a
# MISCONFIGURED mailer is indistinguishable from a working one: the user is
# told a link was sent, the token is stored, and nothing ever arrives. If
# these are absent in production the flow is silently dead. app/main.py logs an
# error at startup when SMTP is unset — that log line is the only symptom.

# How long a reset link stays valid.
AUTH_PASSWORD_RESET_TTL_MINUTES=30

# FALLBACK link base, used only for an app account whose `app_url` is empty.
# The primary source is the account's own app_url, set from the account-
# management console — one auth-service backs several frontends, so a single
# global URL cannot be right for all of them (features/password_reset.py).
# With neither, no email is sent and the failure is logged as an error.
# Accepts either an application root (the reset path is appended) or a URL
# already pointing at the reset screen.
AUTH_PASSWORD_RESET_URL=

# Returns the raw token in the HTTP response when SMTP is unconfigured, so the
# flow can be exercised without a mail server. NEVER set this in production:
# it lets anyone who can name an email address take over that account.
AUTH_EXPOSE_RESET_TOKEN=false

# SMTP. Host and from-address are what decide "configured" — with either
# missing, messages are written to the log instead of sent.
# Gmail needs an app password, not the account password.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_FROM_NAME=RichMinds
# true = STARTTLS on 587 (usual). false = implicit SSL, normally port 465.
AUTH_SMTP_USE_TLS=true
