# Auth Service — environment template.
#
#   cp .env.example .env
#   Fill in AUTH_JWT_SECRET (required) and AUTH_MONGO_URI (recommended) below.
#
# Two settings objects read this file:
#   features/config.py  (AuthSettings)    — what the service authenticates against
#   app/config.py       (ServiceSettings) — how the service is exposed (AUTHSVC_ prefix)
# This mirrors the split already used by the sibling llm-gateway (LLM_ vs
# GATEWAY_) and knowledge-service (RAG_ vs KNOWLEDGE_).

# ──────────────────────────────────────────────────────────────────── identity
# HMAC signing key for every issued token. REQUIRED before exposing this
# service anywhere but localhost — with the built-in dev default, anyone who
# has read this source can forge a valid token for any user. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=

AUTH_JWT_ALGORITHM=HS256

# Access-token lifetime in minutes. Default 720 (12h). There is no refresh
# token — a caller re-authenticates (or re-logs-in) once this expires.
AUTH_ACCESS_TTL_MINUTES=720

# ──────────────────────────────────────────────────────────────────── storage
# MongoDB connection for users / organizations / revoked-token collections.
# Left empty, the service falls back to process-local in-memory storage —
# fine for a quick local run, but data does not survive a restart and is not
# shared across replicas. AUTH_MONGO_DB_NAME defaults to "portless" so this
# service can point at the SAME database the calling application's monolith
# already uses during a transition period; point it at a dedicated
# cluster/db once this service is the source of truth.
AUTH_MONGO_URI=
AUTH_MONGO_DB_NAME=portless

# ─────────────────────────────────────────────────────────────── authorization
# Comma-separated allowlist of platform-staff emails. No domain matching or
# other derivation — an email either is or isn't on this list. Staff can
# create organizations and assign users to them (POST/GET /auth/organizations,
# GET /auth/users, PATCH /auth/users/{id}/organization); everyone else starts
# with no organization until a staff admin assigns one.
AUTH_PORTLESS_EMAILS=

# ──────────────────────────────────────────────────────────────── service (HTTP)
AUTHSVC_HOST=0.0.0.0
AUTHSVC_PORT=8100
AUTHSVC_ROOT_PATH=
AUTHSVC_LOG_LEVEL=INFO
# "json" (default, log-aggregator friendly) | "text" (human-readable, local dev)
AUTHSVC_LOG_FORMAT=json
# development | staging | production — production upgrades the missing-secret
# warning at startup to an error-level log line.
AUTHSVC_ENVIRONMENT=development

# Set false in production if the API is public.
AUTHSVC_DOCS_ENABLED=true

# Comma-separated browser origins allowed to call this service directly
# (e.g. a web UI's login page), or "*" for any. Service-to-service callers
# are unaffected by CORS.
# The knowledge-ingest-ui dev server runs on :5174 (see its vite.config.ts).
AUTHSVC_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

AUTHSVC_REQUEST_ID_HEADER=X-Request-ID
AUTHSVC_EXPOSE_CONFIG_ENDPOINT=true
